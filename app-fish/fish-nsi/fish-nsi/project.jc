import jandcode.jc.ProjectScript
import jandcode.jc.std.JavaProject

class P extends ProjectScript {

    static beforeLoad = {
    }

    void onInclude() {
        //
        project.name = "fish-nsi"
        //
        include(JavaProject).with {
            moduleDef("fish.nsi").with {
                depends.prod(
                    "jandcode.core.apx",
                    "jandcode.core.db.postgresql",
                    "tofi-api-adm",
                    "tofi-api-dta",
                    "tofi-api-mdl",
                    "tofi-auth"

                )
                depends.dev(
                )
            }
        }
    }

}