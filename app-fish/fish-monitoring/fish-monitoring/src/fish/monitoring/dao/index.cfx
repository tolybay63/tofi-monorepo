<?xml version="1.0" encoding="utf-8"?>
<root>

    <dao>

        <holder name="api" invoker="model:default">

            <item name="auth" method="*"
                  class="fish.monitoring.dao.AuthDao"/>

            <item name="data" method="*"
                  class="fish.monitoring.dao.DataDao"/>

            <item name="fill" method="*"
                  class="fish.monitoring.dao.FillDao"/>

            <item name="chart" method="*"
                  class="fish.monitoring.dao.ChartDao"/>

            <item name="psw" class="tofi.auth.TofiPasswordResetAction" method="*"/>

        </holder>

    </dao>

</root>