<?xml version="1.0" encoding="utf-8"?>
<root>

    <dao>

        <holder name="api">

            <item name="auth" method="*" invoker="model:default"
                  class="fish.monitoring.dao.AuthDao"/>

            <item name="data" method="*" invoker="model:default"
                  class="fish.monitoring.dao.DataDao"/>

            <item name="fill" method="*" invoker="model:default"
                  class="fish.monitoring.dao.FillDao"/>

            <item name="chart" method="*" invoker="model:default"
                  class="fish.monitoring.dao.ChartDao"/>

            <item name="psw" class="tofi.auth.TofiPasswordResetAction" method="*"/>

        </holder>

    </dao>

</root>