        <field name="idCalcFishSpec" parent="long"/>
        <field name="pvCalcFishSpec" parent="long"/>
        <field name="fvCalcFishSpec" parent="long"/>

        <field name="idCalcStatus" parent="long"/>
        <field name="pvCalcStatus" parent="long"/>
        <field name="fvCalcStatus" parent="long"/>

        <field name="idCalcUser" parent="long"/>
        <field name="pvCalcUser" parent="long"/>
