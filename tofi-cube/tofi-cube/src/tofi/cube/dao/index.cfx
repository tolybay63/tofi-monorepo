<?xml version="1.0" encoding="utf-8"?>
<root>

    <dao>

        <holder name="api">

            <item name="auth" method="*" invoker="model:default"
                  class="tofi.cube.dao.AuthDao"/>


            <item name="cube" method="*" invoker="model:default"
                  class="tofi.cube.dao.CubeDao"/>

            <item name="psw" class="tofi.auth.TofiPasswordResetAction" method="*"/>

        </holder>

    </dao>

</root>